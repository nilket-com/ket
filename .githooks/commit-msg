#!/usr/bin/env python3
"""Refuse a commit message ci/commit_subjects.py would fail: a bad subject, or any body.

Runs at commit time, before signing. The history rules that need the commit
itself (ADR numbering, plan before impl, author identity) run in pre-push.
"""
import pathlib
import sys

sys.dont_write_bytecode = True
sys.path.insert(0, str(pathlib.Path(__file__).resolve().parent.parent / "ci"))
from commit_subjects import subject_error  # noqa: E402

lines = [line for line in pathlib.Path(sys.argv[1]).read_text(encoding="utf-8").splitlines()
         if not line.startswith("#")]
while lines and not lines[-1].strip():
    lines.pop()
errors = []
if not lines:
    errors.append("empty message")
else:
    error = subject_error(lines[0])
    if error:
        errors.append(error)
    if len(lines) > 1:
        errors.append("commit messages must have no body (no trailers, no attribution lines): "
                      + repr(lines[-1]))
if errors:
    sys.stderr.write("commit-msg: refused, see ci/commit-subjects.md\n")
    for error in errors:
        sys.stderr.write(f"  {error}\n")
    raise SystemExit(1)
