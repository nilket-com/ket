// Calendar tick placement on a DATE axis. `tick_every` deliberately takes an
// interval literal instead of a numeric step: months are calendar units.
let temporal_activity = workspace
	.table("temporal_tick_intervals")
	.sort([asc(col("calendar_date"))]);

temporal_activity.views([
	view("date-months", figure([
		title("Calendar dates").font_size(24),
		subtitle("Month-start ticks on a DATE axis"),
		skin("greys_rs2"),
		x_axis().label("Month").label_size(16).tick_every("1 month"),
		y_axis().label("Active accounts").label_size(16),
		line("calendar_date", "monthly_active").stroke_width(2),
	])),
	view("elapsed-hours", figure([
		title("Elapsed hours across DST").font_size(24),
		subtitle("Fixed six-hour ticks are elapsed time, not civil-clock guesses"),
		skin("greys_rs2"),
		x_axis().label("Observed at").label_size(16).tick_every("6 hours"),
		y_axis().label("Active accounts").label_size(16),
		line("elapsed_at", "hourly_active").stroke_width(2),
	])),
	view("calendar-timestamps", figure([
		title("Calendar months on timestamps").font_size(24),
		subtitle("The same monthly policy is civil-frame aware for TIMESTAMPTZ"),
		skin("greys_rs2"),
		x_axis().label("Month").label_size(16).tick_every("1 month"),
		y_axis().label("Active accounts").label_size(16),
		line("calendar_at", "monthly_active").stroke_width(2),
	])),
	view("count-control", figure([
		title("Count control").font_size(24),
		subtitle("Count placement with compact 36° tick labels"),
		skin("greys_rs2"),
		x_axis().label("Observed at").label_size(16).tick_size(12).tick_rotation(36),
		y_axis().label("Active accounts").label_size(16),
		line("elapsed_at", "hourly_active").stroke_width(2),
	])),
]);
