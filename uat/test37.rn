// PRODUCT-0114 Stage 0: long categorical axis labels.
//
// This is intentionally a geometry probe rather than a polished figure. The
// pre-0115 capture is the unrotated baseline. This version is the rotation
// acceptance figure: the unequal facet domains make grid-wide reservation and
// outer-edge containment observable.
let axis_labels = workspace
	.table("axis_labels_probe")
	.sort([asc(col("axis_order"))]);

axis_labels.views([
	view("long-axis-labels", figure([
		title("Long categorical labels · 45° x-tick rotation"),
		subtitle("Shared bottom-band reservation · inward endpoint anchoring"),
		skin("greys_rs2"),
		padding().top(100).left(200).right(220),
		x_axis().tick_rotation(45),
		facet("facet").gutter(0),
		bar("label", "value").bar_width(0.99),
	])),
]);
