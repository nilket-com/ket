# Example Wendelon single-node bootstrap config.
#
# The checked-in file is a template. The binary can render concrete
# starter values from it with:
#
#   wendelon --print-example-config
#   wendelon --write-example-config ./wendelon.toml
#
# The generated config uses dev-derived signing material for
# `node_id = 1`. That is suitable for local bring-up only. Replace
# the identity section for any non-development deployment.

[node]
node_id = {{NODE_ID}}
advertise_address = "{{ADVERTISE_ADDRESS}}"

[cluster]
mode = "bootstrap"

[storage]
# Resolved relative to the config file location.
data_dir = "{{DATA_DIR}}"
slab_max_bytes = {{SLAB_MAX_BYTES}}

[tuning]
rf = {{RF}}
io_depth = {{IO_DEPTH}}

[identity]
lease_signing_secret = "{{LEASE_SIGNING_SECRET}}"
transfer_signing_secret = "{{TRANSFER_SIGNING_SECRET}}"

[identity.trusted_lease_signers]
"{{NODE_ID}}" = "{{LEASE_VERIFYING_KEY}}"

[identity.trusted_transfer_signers]
"{{NODE_ID}}" = "{{TRANSFER_VERIFYING_KEY}}"

# Optional W4 root-KEK bootstrap selector. `dev-insecure` is the
# current dev/test placeholder. It persists a local plaintext Root
# KEK at `<data_dir>/.wendelon/dev-root-kek.bin` so restarted dev
# nodes can still unwrap prior Tenant KEKs, and is not suitable for
# a production custody boundary.
#
# [crypto]
# root_kek_provider = "dev-insecure"
# tenant_kek_cache_max_entries = 2048
# slab_dek_cache_max_entries = 10000

# Optional inter-node mTLS transport. When configured, Wendelon binds
# the real QUIC transport stack (`quinn`) plus the TCP+TLS fallback
# listener, advertises both tiers, and uses this identity for both
# inbound accepts and outbound dials. Required for multi-node joins
# outside the in-process loopback harness.
#
# [transport.tls]
# cert_path = "certs/node.crt"
# key_path = "certs/node.key"
# node_ca_path = "certs/node-ca.crt"
# operator_ca_path = "certs/ops-ca.crt"
# cluster_domain = "cluster.local"
#
# [time]
# drift_max_offset_ms = 500
#
# Optional observability listener topology. `/ready` and `/metrics`
# are mTLS-gated and therefore require `[transport.tls]`.
#
# [observability.listeners]
# health = "0.0.0.0:7431"
# ready = "0.0.0.0:7432"
# metrics = "0.0.0.0:7433"
