# Example Wendelon single-node bootstrap config.
#
# The checked-in file is a template. The binary can render concrete
# starter values from it with:
#
#   wendelon --print-example-config
#   wendelon --write-example-config ./wendelon.toml
#
# Each rendering generates fresh signing keys and refuses deterministic dev keys.
# This starter still uses the dev-insecure Root KEK for local bring-up only.
# Choose a serious custody provider before any non-development deployment.

[node]
node_id = {{NODE_ID}}
advertise_address = "{{ADVERTISE_ADDRESS}}"

[cluster]
mode = "bootstrap"
# ADR 0721: which write-decision authority a FRESH store is created under.
# A store keeps the authority it was created with; the other is refused.
#   "today" (the default): the existing path.
#   "parent-decisions": requires identity.decision_signing_secret and
#     identity.trusted_decision_signers, time.mvcc_retention_window_secs = 0,
#     and [transport.tls] to join. It is a fresh, disposable checkpoint, NOT a
#     durable deployment: no backup, no member replacement, no resizing (its
#     membership is fixed at the first admitted write, so form the cluster and
#     check its membership before writing), and a limited surface: table writes,
#     single-row deletes, streamed LINEARIZABLE table queries and single-key KV.
# decision_authority = "today"

[storage]
# Resolved relative to the config file location.
data_dir = "{{DATA_DIR}}"
slab_max_bytes = {{SLAB_MAX_BYTES}}
# ADR 0692 §7 node budget for tier history, publication scratch, proposer
# tokens and relocation redirects, in bytes. A publication that cannot
# reserve its history within it is fenced and retried, never grown past it.
# tier_history_budget_bytes = 268435456
# Node-local ADR 055 maintenance switch. Leave false for ordinary nodes.
lsm_compaction_paused = false
# Control log retention: "compacting" (default) snapshots and purges the
# Control log; "full" retains it from genesis and refuses to start over a
# purged history. Every node of a deployment must use the same value.
# control_retention = "compacting"

# ADR 044 L2 columnar fetch is node-local and disabled by default
# until stabilization benchmarks pass.
#
# [storage.l2_column_fetch]
# enabled = false
# ipc_metadata_initial_window_bytes = 65536
# max_ipc_metadata_probe_bytes = 262144
# min_record_bytes = 262144
# max_selected_fraction_micros = 670000
# max_ranges_per_record = 8
# max_parallel_range_gets = 4

# ADR 056 row-group writer/fetch are independently rolled out and
# disabled by default.
#
# [storage.row_group_writer]
# enabled = false
# profile = "point_read" # "point_read" (default) or "scan"
# Numeric fields are PointRead-only overrides; they are ignored with a
# warning when profile = "scan".
# target_row_group_rows = 4096
# max_row_group_rows = 8192
# min_paged_record_rows = 8192
# min_paged_record_bytes = 524288
#
# [storage.l2_row_group_fetch]
# enabled = false
# max_selected_row_group_fraction_micros = 250000
# max_selected_byte_fraction_micros = 500000
# max_ranges_per_record = 16
# max_parallel_range_gets = 4

# ADR 057 Encoding writer/fetch are opt-in and require row-group records.
#
# [storage.encoding_writer]
# enabled = false
# target_simd_page_values = 1024
# cascade_sample_rows = 256
# min_buffer_bytes_for_encoding = 4096
# enabled_cascades = ["plain", "lz4_frame", "bit_packed", "rle", "dictionary", "delta", "fsst", "alp"]
#
# [storage.l2_encoding_fetch]
# enabled = false
# max_simd_pages_per_record = 64
# max_parallel_materialize_tasks = 4
#
# ADR 058 compute-over-encoded-data is node-local and disabled by default.
# The selectivity gate routes encoded predicate leaves at selectivity <= 0.25.
#
# [storage.encoding_compute]
# enabled = false
# max_dict_match_set_size = 4096
# min_buffer_rows_for_encoded_eval = 256
# max_parallel_kernel_tasks = 4
# max_mask_bytes_per_record = 262144
# max_encoded_pages_per_record = 256
# min_selectivity_for_encoded_eval_micros = 250000
# min_prefilter_rejection_micros = 100000
# enabled_predicate_evaluators = ["bit_packed", "rle_plain", "rle_bit_packed", "dictionary_plain", "dictionary_bit_packed", "delta", "fsst"]
# enabled_aggregate_kernels = ["count_star", "count_non_null", "min", "max", "signed_sum", "unsigned_sum", "signed_avg", "unsigned_avg"]

[tuning]
replication_factor = {{REPLICATION_FACTOR}}
wal_io_depth = {{WAL_IO_DEPTH}}
slab_io_depth = {{SLAB_IO_DEPTH}}
# ADR 054/079: bounded CDC watermark progress for quiet localities.
cdc_locality_heartbeat_interval_millis = {{CDC_LOCALITY_HEARTBEAT_INTERVAL_MILLIS}}
# ADR 080: HLC fencing window; renewal cadence is derived as TTL / 3.
data_ring_lease_ttl_millis = {{DATA_RING_LEASE_TTL_MILLIS}}
# ADR 0719: how long one unit of a query's work (for example one location's whole
# read, which for a tiered row is several object-store requests) may run before this
# node refuses the query as stalled. 1 to 600000; absent means 250. A caller's own
# deadline still applies when it is nearer.
query_stall_bound_millis = 250
# ADR 0731: the control group's consensus timing profile, in milliseconds. Heartbeat
# and the nominal timeout of each replication call are this value, the election
# timeout 3 to 6 times it, a snapshot chunk's timeout 4 times it and never under 200.
# 10 to 1000; absent means 50. Set it alike on every node. A larger value is more
# patient with slow replies and slower to replace a lost leader.
consensus_timing_base_millis = 50

[identity]
# Generated signing keys use fresh OS randomness; deterministic dev keys are refused.
allow_dev_keys = false
lease_signing_secret = "{{LEASE_SIGNING_SECRET}}"
transfer_signing_secret = "{{TRANSFER_SIGNING_SECRET}}"
audit_root_signing_secret = "{{AUDIT_ROOT_SIGNING_SECRET}}"
# ADR 0721: only with cluster.decision_authority = "parent-decisions", and then
# required. 64 hex characters; a key of its own, not reused from another role.
# Every node lists every node's verifying key under
# [identity.trusted_decision_signers], like the maps below. A node's bound key
# is never replaced: a node configured with another key later does not start.
# decision_signing_secret = "..."

[identity.trusted_lease_signers]
"{{NODE_ID}}" = "{{LEASE_VERIFYING_KEY}}"

[identity.trusted_transfer_signers]
"{{NODE_ID}}" = "{{TRANSFER_VERIFYING_KEY}}"

[identity.trusted_audit_root_keys]
"{{NODE_ID}}" = "{{AUDIT_ROOT_VERIFYING_KEY}}"

# Root-KEK bootstrap selector.
#
# This checked-in example is explicitly dev-only, so it uses the
# `dev-insecure` provider on purpose. Serious deployments should switch
# this to `local-sealed`, which is the default serious custody path for
# ordinary config loading:
#
#   root_kek_provider = { kind = "local-sealed", unlock_secret_env = "WENDELON_ROOT_KEK_SECRET" }
#   root_kek_provider = { kind = "aws-kms", region = "us-east-1", key_id = "arn:aws:kms:us-east-1:111122223333:key/your-root-kek", access_key_id_env = "AWS_ACCESS_KEY_ID", secret_access_key_env = "AWS_SECRET_ACCESS_KEY", session_token_env = "AWS_SESSION_TOKEN" }
#   root_kek_provider = { kind = "pkcs11", library_path = "/usr/lib/your-pkcs11.so", token_label = "WendelonToken", key_label = "root-kek", pin_env = "WENDELON_PKCS11_PIN", slot = 0 }   # seam only; runtime support not implemented yet
#
# `dev-insecure` persists a local plaintext Root KEK at
# `<data_dir>/.wendelon/dev-root-kek.bin` and is not a real custody
# boundary.

[crypto]
root_kek_provider = "dev-insecure"
tenant_kek_cache_max_entries = 2048
slab_dek_cache_max_entries = 10000

# Optional inter-node mTLS transport. When configured, Wendelon binds
# the real QUIC transport stack (`quinn`) plus the TCP+TLS fallback
# listener, advertises both tiers, and uses this identity for both
# inbound accepts and outbound dials. Required for multi-node joins
# outside the in-process loopback harness.
#
# [transport.tls]
# cert_path = "certs/node.crt"
# key_path = "certs/node.key"
# node_ca_path = "certs/node-ca.crt"
# operator_ca_path = "certs/ops-ca.crt"
# cluster_domain = "cluster.local"
#
# [time]
# drift_max_offset_ms = 500
# mvcc_retention_window_secs = 604800
# Set to `0` to disable MVCC snapshot pruning. Internally this maps to
# the bootstrap retention policy's `Disabled` / `FixedWindow` modes.
#
# Counter dedup horizon. A counter add's write id is refused once it is
# older than `expiry_secs`, and when it was issued more than
# `clock_skew_secs` ahead of this node's clock: keep every node and client
# clock under NTP within `clock_skew_secs`. The expiry must be at least the
# SDK's one-hour client incarnation plus the other two; startup refuses less.
#
# [counter]
# attempt_horizon_secs = 300
# clock_skew_secs = 60
# expiry_secs = 3960
#
# Optional observability listener topology. `/ready` and `/metrics`
# are mTLS-gated and therefore require `[transport.tls]`.
#
# [observability.listeners]
# health = "0.0.0.0:7431"
# ready = "0.0.0.0:7432"
# metrics = "0.0.0.0:7433"
#
# Optional OTLP trace export. Both transports are feature-gated and
# implemented in pure Rust without any protobuf or gRPC codegen:
# `otlp-http` enables `http/protobuf`, `otlp-grpc` enables gRPC.
#
# [observability.traces]
# endpoint = "https://otel-collector.internal:4317"
# protocol = "grpc"                              # or "http/protobuf"
# sampling_rate = 0.01
# client_cert_path = "certs/obs-client.crt"
# client_key_path = "certs/obs-client.key"
# ca_bundle_path = "certs/obs-ca.crt"
# max_queue_size = 8192
# export_timeout_s = 30
#
# Optional additive audit shipping sinks. The local NDJSON audit chain
# at `<data_dir>/audit.ndjson` stays enabled even when these are
# configured; sink shapes and archive guidance are documented in
# `plans/ops/audit.md`.
#
# [audit.archive]
# directory = "/mnt/worm/wendelon-audit/node-01"
# max_segment_bytes = 8388608
# lock_mode = "governance"   # "none", "governance", or "compliance"
# retain_days = 2555
#
# [audit.syslog]
# socket_path = "/run/systemd/journal/syslog"
#
# [audit.kafka]
# brokers = "kafka-1.internal:9092,kafka-2.internal:9092"
# topic = "wendelon.audit"
# payload_mode = "distribution"   # or "canonical" for persisted chain records
# client_id = "wendelon-node-01"
