//! Summarize Toron runtime-filter bench rows.
//!
//! The distributed_inner_equi_join bench emits one CSV-like line per case,
//! prefixed with adr004_distributed_inner_equi_join. This script extracts
//! those rows and computes the deltas ADR 006/007 discussions keep using:
//! probe-row rejection, shuffle-byte rejection, bytes-movement cluster time,
//! wall time, digest parity, and implied Bloom false-positive rate.
//!
//! A port of summarize_runtime_filter_perft.py, kept beside it until the
//! outputs and the failure behaviour are shown to match.

const ROW_PREFIX = "adr004_distributed_inner_equi_join,";
// Separates the parts of a group key. It sorts below every character that can
// appear in a field value, so ordering the joined keys orders the tuples.
const UNIT = "\u{1}";

fn group_keys() {
	[
		"quick",
		"strategy",
		"key",
		"workers",
		"build_rows",
		"probe_rows",
		"probe_key_domain",
	]
}

fn bytes_cluster_fields() {
	[
		"batch_send_ms",
		"shuffle_pull_decode_ms",
		"output_publish_ms",
		"batch_encode_ms",
	]
}

// A row is the object of its field names to their unparsed values.

/// Rune has no `join` on a sequence, so the script carries one.
fn join(parts, separator) {
	let out = "";
	let index = 0;
	while index < parts.len() {
		if index > 0 {
			out += separator;
		}
		out += parts[index];
		index += 1;
	}
	out
}

/// Rune has no `contains` on a sequence either.
fn contains(items, wanted) {
	for item in items {
		if item == wanted {
			return true;
		}
	}
	false
}

fn row_text(row, key) {
	if row.contains_key(key) {
		row[key]
	} else {
		""
	}
}

fn row_number(row, key) {
	if !row.contains_key(key) {
		return Err(`bench row missing required field ${key}`);
	}
	let value = row[key];
	match value.parse::<f64>() {
		Ok(number) => Ok(number),
		Err(_) => Err(`bench row field ${key} is not numeric: ${value}`),
	}
}

fn row_integer(row, key) {
	Ok(row_number(row, key)?.to::<i64>())
}

/// The pair of filter settings, joined so it can key a map.
fn row_mode(row) {
	row_text(row, "runtime_filter") + UNIT + row_text(row, "wendelon_runtime_filter")
}

fn row_group_key(row) {
	let parts = [];
	for key in group_keys() {
		parts.push(row_text(row, key));
	}
	join(parts, UNIT)
}

fn bytes_cluster_ms(row) {
	let total = 0.0;
	for field in bytes_cluster_fields() {
		total += row_number(row, field)?;
	}
	Ok(total)
}

fn parse_row(line) {
	let line = line.trim();
	if !line.starts_with(ROW_PREFIX) {
		return None;
	}
	let values = #{};
	let fields = line.split(",").collect::<Vec>();
	let index = 1;
	while index < fields.len() {
		let field = fields[index];
		index += 1;
		// Only the first `=` separates the name from the value.
		match text::find(field, "=") {
			Some(at) => {
				let name = field.get(0..at).unwrap();
				let value = field.get((at + 1)..field.len()).unwrap();
				values[name] = value;
			}
			None => {}
		}
	}
	Some(values)
}

fn pct_reduction(before, after) {
	if before == 0.0 {
		None
	} else {
		Some((1.0 - (after / before)) * 100.0)
	}
}

/// An integer with a comma every three digits, as Python's `,` format does.
fn fmt_int(value) {
	text::group_digits(value)
}

/// A float to three decimals, grouped past a thousand. The grouping is applied
/// to the rendered integer part rather than to the value, so a number that
/// rounds up into a new digit groups the way the printed digits read.
fn fmt_float(value) {
	let rendered = format!("{:.3}", value);
	if value.abs() < 1000.0 {
		return rendered;
	}
	match text::find(rendered, ".") {
		Some(at) => {
			let whole = rendered.get(0..at).unwrap();
			let fraction = rendered.get(at..rendered.len()).unwrap();
			match whole.parse::<i64>() {
				Ok(number) => text::group_digits(number) + fraction,
				Err(_) => rendered,
			}
		}
		None => rendered,
	}
}

fn fmt_pct(value) {
	match value {
		Some(number) => format!("{:.1}%", number),
		None => "n/a",
	}
}

fn digest_prefix(digest) {
	let end = if digest.len() < 12 { digest.len() } else { 12 };
	digest.get(0..end).unwrap()
}

fn summarize_group(values, rows, require_digest_equality, floors, failures) {
	let lines = [];
	let labels = [];
	let keys = group_keys();
	let index = 0;
	while index < keys.len() {
		labels.push(keys[index] + "=" + values[index]);
		index += 1;
	}
	let group_label = join(labels, ", ");

	let rows_by_mode = #{};
	for row in rows {
		// A later row replaces an earlier one with the same pair of settings.
		rows_by_mode[row_mode(row)] = row;
	}
	let digests = [];
	for row in rows {
		let digest = row_text(row, "digest");
		if digest != "" && !contains(digests, digest) {
			digests.push(digest);
		}
	}
	let digest_status = if digests.len() == 1 { "pass" } else { "fail" };

	if require_digest_equality && digest_status != "pass" {
		failures.push(`${group_label}: digest mismatch across modes`);
	}

	lines.push("## " + group_label);
	lines.push("");
	lines.push("- Digest equality: " + digest_status);
	lines.push("");
	lines.push("| runtime filter | Wendelon filter | shuffle bytes | probe rows | bytes cluster ms | wall ms | digest prefix |");
	lines.push("| --- | --- | ---: | ---: | ---: | ---: | --- |");

	let modes = [
		["enabled", "enabled"],
		["enabled", "disabled"],
		["disabled", "enabled"],
		["disabled", "disabled"],
	];
	for mode in modes {
		let key = mode[0] + UNIT + mode[1];
		if !rows_by_mode.contains_key(key) {
			continue;
		}
		let row = rows_by_mode[key];
		lines.push(format!(
			"| {} | {} | {} | {} | {} | {} | {} |",
			mode[0],
			mode[1],
			fmt_int(row_integer(row, "shuffle_bytes_published")?),
			fmt_int(row_integer(row, "telemetry_probe_rows")?),
			fmt_float(bytes_cluster_ms(row)?),
			fmt_float(row_number(row, "wall_ms")?),
			digest_prefix(row_text(row, "digest")),
		));
	}

	let baseline_key = "disabled" + UNIT + "disabled";
	let filtered_key = "enabled" + UNIT + "enabled";
	if !rows_by_mode.contains_key(baseline_key) || !rows_by_mode.contains_key(filtered_key) {
		failures.push(
			`${group_label}: missing disabled/disabled baseline or enabled/enabled filtered row`,
		);
		lines.push("");
		lines.push("- Delta summary: unavailable");
		lines.push("");
		return Ok(lines);
	}
	let baseline = rows_by_mode[baseline_key];
	let filtered = rows_by_mode[filtered_key];

	let probe_reduction = pct_reduction(
		row_number(baseline, "telemetry_probe_rows")?,
		row_number(filtered, "telemetry_probe_rows")?,
	);
	let shuffle_reduction = pct_reduction(
		row_number(baseline, "shuffle_bytes_published")?,
		row_number(filtered, "shuffle_bytes_published")?,
	);
	let cluster_reduction = pct_reduction(bytes_cluster_ms(baseline)?, bytes_cluster_ms(filtered)?);
	let wall_reduction = pct_reduction(
		row_number(baseline, "wall_ms")?,
		row_number(filtered, "wall_ms")?,
	);

	let true_matches = row_integer(filtered, "matched_rows")?;
	let filtered_probe_rows = row_integer(filtered, "telemetry_probe_rows")?;
	let baseline_probe_rows = row_integer(baseline, "telemetry_probe_rows")?;
	let implied_false_positives = (filtered_probe_rows - true_matches).max(0);
	let baseline_non_matches = (baseline_probe_rows - true_matches).max(0);
	let implied_fp_rate = if baseline_non_matches != 0 {
		Some(implied_false_positives.to::<f64>() / baseline_non_matches.to::<f64>() * 100.0)
	} else {
		None
	};

	lines.push("");
	lines.push(format!(
		"- Filtered vs baseline: probe rows {}, shuffle bytes {}, bytes cluster {}, wall {}.",
		fmt_pct(probe_reduction),
		fmt_pct(shuffle_reduction),
		fmt_pct(cluster_reduction),
		fmt_pct(wall_reduction),
	));
	lines.push(format!(
		"- Implied Bloom false positives: {} / {} ({}).",
		fmt_int(implied_false_positives),
		fmt_int(baseline_non_matches),
		fmt_pct(implied_fp_rate),
	));
	lines.push("");

	check_floor(
		floors["probe"],
		probe_reduction,
		group_label,
		"probe-row",
		failures,
	);
	check_floor(
		floors["shuffle"],
		shuffle_reduction,
		group_label,
		"shuffle-byte",
		failures,
	);
	check_floor(
		floors["cluster"],
		cluster_reduction,
		group_label,
		"bytes-cluster",
		failures,
	);

	Ok(lines)
}

fn check_floor(floor, measured, group_label, what, failures) {
	// Both the floor and the measurement are optional: an absent flag and a
	// reduction against a zero baseline each mean there is nothing to check.
	let floor = match floor {
		Some(value) => value,
		None => return,
	};
	let measured = match measured {
		Some(value) => value,
		None => return,
	};
	if measured < floor {
		failures.push(format!(
			"{}: {} reduction {:.1}% below {:.1}%",
			group_label,
			what,
			measured,
			floor,
		));
	}
}

fn usage() {
	"usage: summarize_runtime_filter_perft.rn [--require-digest-equality] \
[--min-probe-reduction-pct PCT] [--min-shuffle-reduction-pct PCT] \
[--min-cluster-reduction-pct PCT] [PATH...]; reads standard input when \
given no path"
}

pub fn main(args) {
	let paths = [];
	let require_digest_equality = false;
	let floors = #{ probe: None, shuffle: None, cluster: None };
	let index = 0;
	while index < args.len() {
		let argument = args[index];
		index += 1;
		if argument == "--require-digest-equality" {
			require_digest_equality = true;
			continue;
		}
		let name = argument;
		let inline = None;
		match text::find(argument, "=") {
			Some(at) => if argument.starts_with("--") {
				name = argument.get(0..at).unwrap();
				inline = Some(argument.get((at + 1)..argument.len()).unwrap());
			},
			None => {}
		}
		if name == "--require-digest-equality" {
			return Err(`${name} takes no value\n${usage()}`);
		}
		let slot = if name == "--min-probe-reduction-pct" {
			"probe"
		} else if name == "--min-shuffle-reduction-pct" {
			"shuffle"
		} else if name == "--min-cluster-reduction-pct" {
			"cluster"
		} else if name.starts_with("--") {
			return Err(`unrecognized flag ${name}\n${usage()}`);
		} else {
			paths.push(argument);
			continue;
		};
		let given = match inline {
			Some(value) => value,
			None => {
				if index >= args.len() {
					return Err(`${name} needs a percentage\n${usage()}`);
				}
				let value = args[index];
				index += 1;
				value
			}
		};
		floors[slot] = match given.parse::<f64>() {
			Ok(number) => Some(number),
			Err(_) => return Err(`${name} needs a number, not ${given}`),
		};
	}

	// Given no path the original reads standard input, and so does this.
	let documents = [];
	if paths.is_empty() {
		documents.push(host::stdin()?);
	} else {
		for path in paths {
			documents.push(host::read(path)?);
		}
	}

	let rows = [];
	for contents in documents {
		for line in contents.split("\n") {
			match parse_row(line) {
				Some(row) => rows.push(row),
				None => {}
			}
		}
	}
	if rows.is_empty() {
		return Err("no adr004_distributed_inner_equi_join rows found");
	}

	let groups = #{};
	let order = [];
	for row in rows {
		let key = row_group_key(row);
		if !groups.contains_key(key) {
			groups[key] = [];
			order.push(key);
		}
		groups[key].push(row);
	}
	order.sort();

	let failures = [];
	let output = ["# Runtime Filter Perft Summary", ""];
	for key in order {
		let values = key.split(UNIT).collect::<Vec>();
		for line in summarize_group(
			values,
			groups[key],
			require_digest_equality,
			floors,
			failures,
		)? {
			output.push(line);
		}
	}

	if !failures.is_empty() {
		output.push("## Validation Failures");
		output.push("");
		for failure in failures {
			output.push("- " + failure);
		}
		output.push("");
	}

	println!("{}", join(output, "\n"));
	if failures.is_empty() {
		Ok(())
	} else {
		Err("")
	}
}
